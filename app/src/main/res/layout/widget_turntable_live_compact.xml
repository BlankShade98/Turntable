<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/bg_widget_corner_24" />

    <LinearLayout
        android:id="@+id/widget_content_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/cd_album_art"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:id="@+id/widget_text_col"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="top"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingTop="12dp"
            android:paddingEnd="6dp">

            <ImageView
                android:id="@+id/widget_title_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/empty_track_title"
                android:scaleType="fitStart" />

            <ImageView
                android:id="@+id/widget_artist_image"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:contentDescription="@string/empty_track_subtitle"
                android:scaleType="fitStart" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_right_col"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="end|bottom"
            android:orientation="vertical"
            android:paddingTop="7dp"
            android:paddingBottom="7dp">

            <FrameLayout
                android:id="@+id/widget_spotify_pill"
                android:layout_width="wrap_content"
                android:layout_height="22dp">

                <ImageView
                    android:id="@+id/widget_spotify_pill_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@null"
                    android:scaleType="fitXY"
                    android:src="@drawable/bg_widget_btn_pill" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/widget_spotify_icon"
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/ic_widget_music_waves" />

                    <ImageView
                        android:id="@+id/widget_spotify_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:contentDescription="@string/label_spotify"
                        android:scaleType="fitCenter" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp">

                    <ImageView
                        android:id="@+id/widget_icon_prev"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_previous_track"
                        android:src="@drawable/ic_widget_previous" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="5dp">

                    <ImageView
                        android:id="@+id/widget_icon_next"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_next_track"
                        android:src="@drawable/ic_widget_next" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="48dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="6dp">

                    <ImageView
                        android:id="@+id/widget_play_bg"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/bg_widget_btn_pill" />

                    <ImageView
                        android:id="@+id/widget_icon_play_pause"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/action_play_pause"
                        android:src="@drawable/ic_widget_play" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
